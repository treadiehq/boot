{
  "name": "boot",
  "version": "0.3.8",
  "description": "Your workspace, wherever you work.",
  "type": "module",
  "bin": {
    "boot": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "tsc --noEmit",
    "qa": "bash scripts/qa.sh",
    "test:distribution:linux": "bash scripts/distribution/e2e.sh",
    "benchmark:agent": "bash scripts/benchmarks/run.sh",
    "demo": "bash scripts/demo.sh",
    "e2b:validate": "tsc --noEmit -p templates/e2b/boot-agent/tsconfig.json && tsx templates/e2b/boot-agent/validate.ts",
    "e2b:build": "tsx templates/e2b/boot-agent/build.ts",
    "e2b:launch": "tsx templates/e2b/boot-agent/launch.ts",
    "e2b:smoke": "tsx templates/e2b/boot-agent/smoke.ts",
    "ui:dev": "NODE_OPTIONS=--experimental-require-module nuxi dev ui",
    "ui:build": "NODE_OPTIONS=--experimental-require-module nuxi generate ui",
    "build:binary": "bash scripts/build-release.sh",
    "video:audio": "node video/generate-audio.mjs",
    "video:check": "tsc --noEmit -p video/tsconfig.json",
    "video:studio": "pnpm video:audio && remotion studio video/index.ts",
    "video:render": "pnpm video:audio && remotion render video/index.ts BootLaunch out/boot-launch.mp4 --codec=h264",
    "video:still:v037": "pnpm video:audio && remotion still video/index.ts AgentBootstrapUpdate out/boot-v0.3.7-preview.png --frame=320",
    "video:render:v037": "pnpm video:audio && remotion render video/index.ts AgentBootstrapUpdate out/boot-v0.3.7.mp4 --codec=h264"
  },
  "keywords": [
    "cli",
    "git",
    "workspace",
    "coding-agents",
    "environment",
    "developer-tools",
    "boot"
  ],
  "license": "FSL-1.1-MIT",
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "execa": "^9.6.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "fuse-native": "^2.2.6"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.489",
    "@remotion/media": "4.0.489",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "e2b": "^2.39.0",
    "nuxt": "^4.5.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "remotion": "4.0.489",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^3.2.6",
    "vue": "^3.5.40"
  }
}
